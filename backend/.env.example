# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored - never commit real secrets.

# --- Database -------------------------------------------------------------
# Leave unset to use the local SQLite file (no database server needed).
# For Docker Compose, this is set for you in docker-compose.yml.
# DATABASE_URL=postgresql+psycopg://dinesense:dinesense@localhost:5432/dinesense

# --- Security -------------------------------------------------------------
# REQUIRED before deploying. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-generated-value-at-least-32-bytes-long
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- App ------------------------------------------------------------------
DEBUG=true
MAX_BATCH_ROWS=5000
